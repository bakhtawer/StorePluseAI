# StorePulse AI - Environment Configuration Template

# Gemini AI API Key (Injected automatically in AI Studio or configured in production)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public Application URL
APP_URL="http://localhost:3000"

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Backend server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google PageSpeed Insights API Key (Optional for performance audits)
PAGESPEED_API_KEY="your-pagespeed-api-key"

# Server Port
PORT=3000
